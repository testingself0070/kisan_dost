# Copy this file to ".env" and fill in your real key. Never commit ".env" itself.

# Get a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: change the model. gemini-2.0-flash is fast and free-tier friendly.
GEMINI_MODEL=gemini-2.0-flash
